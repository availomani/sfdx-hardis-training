<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>A planned installation with a crew and a date is scheduled: the status follows the facts rather than waiting for somebody to change it.</description>
        <name>Move_To_Scheduled</name>
        <label>Move To Scheduled</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Scheduled</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <description>When a planner puts a crew on a planned installation that already has a date, the installation moves to Scheduled on its own.</description>
    <environments>Default</environments>
    <interviewLabel>Installation Assign Crew {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Installation Assign Crew</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Move_To_Scheduled</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.Crew_Size__c})),
  NOT(ISBLANK({!$Record.Install_Date__c})),
  ISPICKVAL({!$Record.Status__c}, &quot;Planned&quot;)
)</filterFormula>
        <object>Installation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
