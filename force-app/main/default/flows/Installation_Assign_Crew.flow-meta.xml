<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>US-018: the crew never exceeds the cap the planner set on the installation.</description>
        <name>Bring_Crew_Back_To_Cap</name>
        <label>Bring Crew Back To Cap</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>$Record.Crew_Size__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Crew_Capacity_Cap__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>A planned installation with a crew and a date is scheduled: the status follows the facts rather than waiting for somebody to change it.</description>
        <name>Move_To_Scheduled</name>
        <label>Move To Scheduled</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Scheduled</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Flat_Roof_Minimum</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>US-034: a flat roof needs a crew of at least three.</description>
        <name>Raise_Crew_To_Three</name>
        <label>Raise Crew To Three</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>$Record.Crew_Size__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Crew_Over_Cap</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Is the crew larger than the cap this installation allows?</description>
        <name>Crew_Over_Cap</name>
        <label>Crew Over Cap</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Within the cap</defaultConnectorLabel>
        <rules>
            <name>Too_Large</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Crew_Capacity_Cap__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Crew_Size__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Record.Crew_Capacity_Cap__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bring_Crew_Back_To_Cap</targetReference>
            </connector>
            <label>Too large for this installation</label>
        </rules>
    </decisions>
    <decisions>
        <description>Does a flat roof have fewer than three people on it? Runs before the cap, so the cap has the last word.</description>
        <name>Flat_Roof_Minimum</name>
        <label>Flat Roof Minimum</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Crew_Over_Cap</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Crew is enough</defaultConnectorLabel>
        <rules>
            <name>Too_Small_For_Flat_Roof</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Roof_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Flat</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Crew_Size__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Raise_Crew_To_Three</targetReference>
            </connector>
            <label>Too small for a flat roof</label>
        </rules>
    </decisions>
    <description>When a planner puts a crew on a planned installation that already has a date, the installation moves to Scheduled on its own. A crew larger than the installation cap is brought back down to the cap: too many people on a small roof is a safety problem.</description>
    <environments>Default</environments>
    <interviewLabel>Installation Assign Crew {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Installation Assign Crew</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Move_To_Scheduled</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.Crew_Size__c})),
  NOT(ISBLANK({!$Record.Install_Date__c})),
  ISPICKVAL({!$Record.Status__c}, &quot;Planned&quot;)
)</filterFormula>
        <object>Installation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
